<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="VLCStream" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/VLCStream" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-Og" />
					<Add option="-g" />
					<Add option="-mconsole" />
				</Compiler>
				<Linker>
					<Add option="-mconsole" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/VLCStream" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-mwindows" />
				</Compiler>
				<Linker>
					<Add option="-mwindows" />
				</Linker>
				<ExtraCommands>
					<Add after="strip.exe bin\Release\vlcstream.exe" />
				</ExtraCommands>
			</Target>
		</Build>
		<Compiler>
			<Add option="-O3" />
			<Add option="-Wall" />
			<Add option="-m32" />
			<Add option="-fno-strict-aliasing" />
			<Add option="-std=gnu18" />
			<Add option="-D__MSVCRT_VERSION__=0x0701" />
			<Add option="-D_WIN32 -mwin32" />
			<Add option="-D_WIN32_WINDOWS=0x0700" />
			<Add option="-D_WIN32_IE=0x0603" />
			<Add option="-D_WIN32_WINNT=0x0601" />
			<Add option="-DWINVER=0x0601" />
			<Add option="-D__WIN32__=1" />
			<Add option="-DPSAPI_VERSION=1" />
			<Add directory="../src/include" />
			<Add directory="../src/sdk/include" />
		</Compiler>
		<ResourceCompiler>
			<Add option="--output-format=coff" />
			<Add option="--target=pe-i386" />
		</ResourceCompiler>
		<Linker>
			<Add option="-static-libstdc++" />
			<Add option="-static-libgcc" />
			<Add option="-static" />
			<Add option="-m32" />
			<Add option="-lntdll -lstdc++ -lpthread -lsetupapi -lpdh -lgdi32 -lwinmm -lpsapi -lshlwapi -ldxguid -ldinput -lole32 -lcomctl32 -loleaut32 -luuid -lgdiplus -lwininet" />
			<Add library="../src/libs/x32/bass.lib" />
			<Add library="../src/libs/x32/basswasapi.lib" />
			<Add library="../src/libs/x32/libhook.a" />
			<Add library="../src/libs/x32/libmylcddll.a" />
			<Add library="../src/libs/x32/libusb.a" />
			<Add library="../src/sdk/lib/libvlc.dll.a" />
			<Add library="../src/sdk/lib/libvlccore.dll.a" />
			<Add directory="../src/libs" />
			<Add directory="../src/sdk/lib" />
			<Add directory="../src/hook/x32" />
		</Linker>
